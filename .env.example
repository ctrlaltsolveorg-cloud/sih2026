# KisanBandhan AI Environment Variables Template
# Copy this file to .env.local and add your actual Supabase credentials

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
NEXT_PUBLIC_APP_NAME="KisanBandhan AI"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# AI Inference Keys (100% Free)
GEMINI_API_KEY=your_gemini_api_key_from_aistudio
GROQ_API_KEY=your_free_groq_key_from_console_groq_com
NEXT_PUBLIC_GROQ_API_KEY=your_free_groq_key_from_console_groq_com
HUGGINGFACE_API_KEY=your_huggingface_token_from_hf_co_settings_tokens
NEXT_PUBLIC_HUGGINGFACE_API_KEY=your_huggingface_token_from_hf_co_settings_tokens
